# Server-only vars — do NOT prefix with NEXT_PUBLIC_

# Supabase / PostgreSQL connection string
# Direct (Port 5432) or Supabase Connection Pooler (Port 6543 / 5432):
# e.g. postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Random secret for signing the session JWT (e.g. `openssl rand -hex 48`)
AUTH_SECRET=

# OpenRouter API key used by the label-analysis route
OPENROUTER_API=
