# Server-only vars — do NOT prefix with NEXT_PUBLIC_

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host:port/neondb?sslmode=verify-full

# Random secret for signing the session JWT (e.g. `openssl rand -hex 48`)
AUTH_SECRET=

# OpenRouter API key used by the label-analysis route
OPENROUTER_API=
